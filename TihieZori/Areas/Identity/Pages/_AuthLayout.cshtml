@using Microsoft.AspNetCore.Identity
@using TihieZori.Models
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Тихие Зори</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TihieZori.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <style>
            /* Фон с градиентом */
            body {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0;
                overflow: hidden;
                position: relative;
            }

            /* Контейнер для пузырьков */
            .bubbles {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                pointer-events: none;
                z-index: 0;
                overflow: hidden;
            }

            /* Отдельный пузырек */
            .bubble {
                position: absolute;
                bottom: -100px;
                background: rgba(255, 255, 255, 0.08);
                border-radius: 50%;
                border: 1px solid rgba(255, 255, 255, 0.1);
                animation: rise linear infinite;
                backdrop-filter: blur(2px);
            }

                /* Разные размеры пузырьков */
                .bubble:nth-child(1) {
                    width: 20px;
                    height: 20px;
                    left: 10%;
                    animation-duration: 12s;
                    animation-delay: 0s;
                }

                .bubble:nth-child(2) {
                    width: 40px;
                    height: 40px;
                    left: 20%;
                    animation-duration: 16s;
                    animation-delay: 2s;
                }

                .bubble:nth-child(3) {
                    width: 25px;
                    height: 25px;
                    left: 30%;
                    animation-duration: 14s;
                    animation-delay: 4s;
                }

                .bubble:nth-child(4) {
                    width: 50px;
                    height: 50px;
                    left: 40%;
                    animation-duration: 18s;
                    animation-delay: 1s;
                }

                .bubble:nth-child(5) {
                    width: 30px;
                    height: 30px;
                    left: 50%;
                    animation-duration: 13s;
                    animation-delay: 3s;
                }

                .bubble:nth-child(6) {
                    width: 45px;
                    height: 45px;
                    left: 60%;
                    animation-duration: 17s;
                    animation-delay: 5s;
                }

                .bubble:nth-child(7) {
                    width: 35px;
                    height: 35px;
                    left: 70%;
                    animation-duration: 15s;
                    animation-delay: 2s;
                }

                .bubble:nth-child(8) {
                    width: 60px;
                    height: 60px;
                    left: 80%;
                    animation-duration: 20s;
                    animation-delay: 0s;
                }

                .bubble:nth-child(9) {
                    width: 28px;
                    height: 28px;
                    left: 90%;
                    animation-duration: 12s;
                    animation-delay: 6s;
                }

                .bubble:nth-child(10) {
                    width: 55px;
                    height: 55px;
                    left: 15%;
                    animation-duration: 19s;
                    animation-delay: 3s;
                }

                .bubble:nth-child(11) {
                    width: 38px;
                    height: 38px;
                    left: 45%;
                    animation-duration: 14s;
                    animation-delay: 7s;
                }

                .bubble:nth-child(12) {
                    width: 22px;
                    height: 22px;
                    left: 75%;
                    animation-duration: 11s;
                    animation-delay: 4s;
                }

            /* Анимация подъема пузырька */
            @@keyframes rise {
                0% {
                    transform: translateY(0) translateX(0) scale(1);
                    opacity: 0.8;
                }

                25% {
                    transform: translateY(-25vh) translateX(15px) scale(1.1);
                    opacity: 0.7;
                }

                50% {
                    transform: translateY(-50vh) translateX(-10px) scale(1.2);
                    opacity: 0.6;
                }

                75% {
                    transform: translateY(-75vh) translateX(20px) scale(1.15);
                    opacity: 0.4;
                }

                100% {
                    transform: translateY(-110vh) translateX(-5px) scale(1.3);
                    opacity: 0;
                }
            }

            /* Карточка поверх пузырьков */
            .card {
                border-radius: 1rem;
                backdrop-filter: blur(10px);
                background: rgba(255, 255, 255, 0.95);
                position: relative;
                z-index: 1;
                box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            }

            .form-floating > .form-control {
                border-radius: 0.5rem;
            }

                .form-floating > .form-control:focus {
                    border-color: #0d6efd;
                    box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
                }

            .btn {
                border-radius: 0.5rem;
                font-weight: 500;
                padding: 0.75rem 1rem;
            }

            .validation-summary-errors {
                background: #f8d7da;
                border-radius: 0.5rem;
                padding: 0.75rem;
                margin-bottom: 1rem;
            }

            /* Логотип с тенью */
            .logo-text {
                text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
            }
    </style>
</head>
<body>
    <!-- Пузырьки на фоне -->
    <div class="bubbles">
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
    </div>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <!-- Логотип -->
                <div class="text-center mb-4">
                    <a href="/" class="text-white text-decoration-none">
                        <h1 class="display-4 fw-bold logo-text">
                            <i class="bi bi-shield-check"></i> TihieZori
                        </h1>
                        <p class="text-white-50">Тихие Зори</p>
                    </a>
                </div>

                <!-- Основной контент -->
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>