@page
@model TihieZori.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Вход в систему";
    Layout = "~/Areas/Identity/Pages/_AuthLayout.cshtml";
}

<style>
    .custom-checkbox {
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        user-select: none;
        padding: 8px 12px;
        border-radius: 8px;
        transition: background-color 0.3s ease;
    }

        .custom-checkbox:hover {
            background-color: rgba(13, 110, 253, 0.05);
        }

        .custom-checkbox input[type="checkbox"] {
            appearance: none;
            -webkit-appearance: none;
            width: 22px;
            height: 22px;
            border: 2px solid #d1d5db;
            border-radius: 6px;
            outline: none;
            cursor: pointer;
            position: relative;
            transition: all 0.3s ease;
            flex-shrink: 0;
            background-color: white;
        }

            .custom-checkbox input[type="checkbox"]:checked {
                background-color: #0d6efd;
                border-color: #0d6efd;
                animation: checkPop 0.3s ease;
            }

                .custom-checkbox input[type="checkbox"]:checked::after {
                    content: '✓';
                    position: absolute;
                    top: 50%;
                    left: 50%;
                    transform: translate(-50%, -50%);
                    color: white;
                    font-size: 16px;
                    font-weight: bold;
                }

            .custom-checkbox input[type="checkbox"]:hover {
                border-color: #0d6efd;
                transform: scale(1.05);
            }

            .custom-checkbox input[type="checkbox"]:focus {
                box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.25);
            }

        .custom-checkbox .checkbox-label {
            color: #4b5563;
            font-size: 0.95rem;
            cursor: pointer;
            transition: color 0.3s ease;
            font-weight: 500;
        }

        .custom-checkbox:hover .checkbox-label {
            color: #0d6efd;
        }

    @@keyframes checkPop {
        0% {
            transform: scale(0.8);
        }

        50% {
            transform: scale(1.2);
        }

        100% {
            transform: scale(1);
        }
    }

    /* Стили для ошибок */
    .error-message {
        background: linear-gradient(135deg, #f8d7da 0%, #f5c2c7 100%);
        border: 1px solid #f5c2c7;
        border-radius: 0.75rem;
        padding: 1rem 1.25rem;
        margin-bottom: 1.5rem;
        color: #842029;
        animation: slideDown 0.3s ease-out;
        box-shadow: 0 4px 12px rgba(220, 53, 69, 0.15);
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .error-message .error-icon {
            font-size: 1.5rem;
            flex-shrink: 0;
        }

        .error-message .error-text {
            font-weight: 500;
            font-size: 1rem;
            margin: 0;
        }

    .field-error {
        color: #dc3545;
        font-size: 0.875rem;
        font-weight: 500;
        display: block;
        margin-top: 4px;
        animation: slideDown 0.3s ease-out;
    }

    .input-error {
        border-color: #dc3545 !important;
        box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25) !important;
        animation: shake 0.5s ease-in-out;
    }

    .shake {
        animation: shake 0.5s ease-in-out;
    }

    @@keyframes shake {
        0%, 100% {
            transform: translateX(0);
        }

        20% {
            transform: translateX(-12px);
        }

        40% {
            transform: translateX(12px);
        }

        60% {
            transform: translateX(-8px);
        }

        80% {
            transform: translateX(8px);
        }
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Стили для поля пароля с кнопкой */
    .password-toggle {
        position: relative;
    }

        .password-toggle .toggle-password {
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #6c757d;
            z-index: 10;
            background: transparent;
            border: none;
            padding: 8px;
            font-size: 1.1rem;
            transition: color 0.3s ease;
        }

            .password-toggle .toggle-password:hover {
                color: #0d6efd;
            }

            .password-toggle .toggle-password:focus {
                outline: none;
                color: #0a58ca;
            }

        .password-toggle input {
            padding-right: 50px !important;
        }
</style>

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <i class="bi bi-shield-lock" style="font-size: 3rem; color: #0d6efd;"></i>
                    <h3 class="mt-2">Добро пожаловать!</h3>
                    <p class="text-muted">Войдите в свою учетную запись</p>
                </div>

                <form id="account" method="post">
                    @Html.AntiForgeryToken()

                    <!-- Контейнер для ошибок -->
                    <div id="errorContainer">
                        @if (ViewData["LoginError"] != null)
                        {
                            <div class="error-message shake" id="loginError" role="alert">
                                <span class="error-icon">❌</span>
                                <p class="error-text">@ViewData["LoginError"]</p>
                            </div>
                        }
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" placeholder="name@example.com" />
                        <label asp-for="Input.Email">Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger" id="emailError"></span>
                        @if (ViewData["EmailError"] != null)
                        {
                            <span class="field-error" id="emailErrorManual">@ViewData["EmailError"]</span>
                        }
                    </div>

                    <div class="form-floating mb-3 password-toggle">
                        <input asp-for="Input.Password" class="form-control" placeholder="password"
                               />
                        <label asp-for="Input.Password">Пароль</label>
                        <button type="button" class="toggle-password" id="togglePassword"
                                aria-label="Показать/скрыть пароль">
                            <i class="bi bi-eye" id="passwordIcon"></i>
                        </button>
                        <span asp-validation-for="Input.Password" class="text-danger" id="passwordError"></span>
                        @if (ViewData["PasswordError"] != null)
                        {
                            <span class="field-error" id="passwordErrorManual">@ViewData["PasswordError"]</span>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="custom-checkbox">
                            <input type="checkbox" asp-for="Input.RememberMe"
                                   id="Input_RememberMe" name="Input.RememberMe" value="true" />
                            <span class="checkbox-label">
                                <i class="bi bi-clock-history"></i> Запомнить меня
                            </span>
                        </label>
                        <input type="hidden" name="Input.RememberMe" value="false" />
                    </div>

                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">
                        <i class="bi bi-box-arrow-in-right"></i> Войти
                    </button>

                    <div class="mt-4 text-center">
                        <p>
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none">
                                <i class="bi bi-person-plus"></i> Нет аккаунта? Зарегистрироваться
                            </a>
                        </p>
                        <p>
                            <a asp-page="/Account/ForgotPassword" class="text-decoration-none text-muted small">
                                <i class="bi bi-key"></i> Забыли пароль?
                            </a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function() {
            // Переключение видимости пароля
            $('#togglePassword').on('click', function() {
                const passwordInput = $('#Input_Password');
                const icon = $('#passwordIcon');

                if (passwordInput.attr('type') === 'password') {
                    passwordInput.attr('type', 'text');
                    icon.removeClass('bi-eye').addClass('bi-eye-slash');
                } else {
                    passwordInput.attr('type', 'password');
                    icon.removeClass('bi-eye-slash').addClass('bi-eye');
                }
            });

            // Функция для проверки наличия ошибок
            function hasErrors() {
                return $('#loginError').length > 0 ||
                    $('#emailErrorManual').length > 0 ||
                    $('#passwordErrorManual').length > 0 ||
                    $('.field-error').length > 0;
            }

            // НЕ скрываем ошибки при вводе, если они пришли с сервера
            // Только если пользователь начал исправлять поле с ошибкой
            $('#Input_Email, #Input_Password').on('input', function() {
                const field = $(this);
                const fieldId = field.attr('id');

                // Убираем подсветку ошибки
                field.removeClass('input-error');

                // Удаляем manual ошибку для этого поля
                if (fieldId === 'Input_Email') {
                    $('#emailErrorManual').remove();
                } else if (fieldId === 'Input_Password') {
                    $('#passwordErrorManual').remove();
                }

                // Проверяем, остались ли еще ошибки
                if (!hasErrors()) {
                    $('#loginError').fadeOut(300);
                }
            });

            // Валидация перед отправкой
            $('#login-submit').on('click', function(e) {
                // Не блокируем отправку, просто подсвечиваем пустые поля
                const email = $('#Input_Email').val().trim();
                const password = $('#Input_Password').val();

                let hasClientError = false;

                // Удаляем старые клиентские ошибки
                $('#emailErrorManual, #passwordErrorManual, #loginError').remove();

                if (!email) {
                    $('#Input_Email').addClass('input-error');
                    $('#Input_Email').closest('.form-floating').append(
                        '<span class="field-error" id="emailErrorManual">Введите email</span>'
                    );
                    hasClientError = true;
                }

                if (!password) {
                    $('#Input_Password').addClass('input-error');
                    $('#Input_Password').closest('.form-floating').append(
                        '<span class="field-error" id="passwordErrorManual">Введите пароль</span>'
                    );
                    hasClientError = true;
                }

                // Если есть клиентские ошибки - показываем и блокируем отправку
                if (hasClientError) {
                    e.preventDefault();
                    $('#errorContainer').prepend(`
                                <div class="error-message shake" id="loginError" role="alert">
                                    <span class="error-icon">⚠️</span>
                                    <p class="error-text">Пожалуйста, заполните все обязательные поля</p>
                                </div>
                            `);
                    return false;
                }
            });

            // Скрываем ошибки при фокусе на поле (только клиентские)
            $('#Input_Email, #Input_Password').on('focus', function() {
                const field = $(this);
                const fieldId = field.attr('id');

                if (fieldId === 'Input_Email') {
                    $('#emailErrorManual').remove();
                } else if (fieldId === 'Input_Password') {
                    $('#passwordErrorManual').remove();
                }

                field.removeClass('input-error');

                // Если нет других ошибок - скрываем общую
                if (!hasErrors()) {
                    $('#loginError').fadeOut(300);
                }
            });
        });
    </script>
}