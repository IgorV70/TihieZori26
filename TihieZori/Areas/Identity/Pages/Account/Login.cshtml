@page
@model TihieZori.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Вход в систему";
    Layout = "~/Areas/Identity/Pages/_AuthLayout.cshtml";
}

<style>
    .custom-checkbox {
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        user-select: none;
        padding: 8px 12px;
        border-radius: 8px;
        transition: background-color 0.3s ease;
    }
    
    .custom-checkbox:hover {
        background-color: rgba(13, 110, 253, 0.05);
    }
    
    .custom-checkbox input[type="checkbox"] {
        appearance: none;
        -webkit-appearance: none;
        width: 22px;
        height: 22px;
        border: 2px solid #d1d5db;
        border-radius: 6px;
        outline: none;
        cursor: pointer;
        position: relative;
        transition: all 0.3s ease;
        flex-shrink: 0;
        background-color: white;
    }
    
    .custom-checkbox input[type="checkbox"]:checked {
        background-color: #0d6efd;
        border-color: #0d6efd;
        animation: checkPop 0.3s ease;
    }
    
    .custom-checkbox input[type="checkbox"]:checked::after {
        content: '✓';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        color: white;
        font-size: 16px;
        font-weight: bold;
    }
    
    .custom-checkbox input[type="checkbox"]:hover {
        border-color: #0d6efd;
        transform: scale(1.05);
    }
    
    .custom-checkbox input[type="checkbox"]:focus {
        box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.25);
    }
    
    .custom-checkbox .checkbox-label {
        color: #4b5563;
        font-size: 0.95rem;
        cursor: pointer;
        transition: color 0.3s ease;
        font-weight: 500;
    }
    
    .custom-checkbox:hover .checkbox-label {
        color: #0d6efd;
    }
    
    @@keyframes checkPop {
        0% { transform: scale(0.8); }
        50% { transform: scale(1.2); }
        100% { transform: scale(1); }
    }
</style>

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <i class="bi bi-shield-lock" style="font-size: 3rem; color: #0d6efd;"></i>
                    <h3 class="mt-2">Добро пожаловать!</h3>
                    <p class="text-muted">Войдите в свою учетную запись</p>
                </div>

               <form id="account" method="post" asp-page-handler="Login">
                    @Html.AntiForgeryToken()
                    
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" placeholder="name@example.com" />
                        <label asp-for="Input.Email">Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" placeholder="password" />
                        <label asp-for="Input.Password">Пароль</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    
                    <!-- Ошибка "Неверный email или пароль" будет показана здесь -->
                    <div id="loginError" class="text-danger mb-3" style="display:none;">
                        <i class="bi bi-exclamation-triangle"></i>
                        <span id="errorMessage"></span>
                    </div>

                    <!-- Красивый чекбокс -->
                    <div class="mb-3">
                        <label class="custom-checkbox">
                            <input type="checkbox" asp-for="Input.RememberMe" />
                            <span class="checkbox-label">
                                <i class="bi bi-clock-history"></i> Запомнить меня
                            </span>
                        </label>
                    </div>
                    
                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">
                        <i class="bi bi-box-arrow-in-right"></i> Войти
                    </button>
                    
                    <div class="mt-4 text-center">
                        <p>
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none">
                                <i class="bi bi-person-plus"></i> Нет аккаунта? Зарегистрироваться
                            </a>
                        </p>
                        <p>
                            <a id="forgot-password" asp-page="./ForgotPassword" class="text-decoration-none text-muted small">
                                <i class="bi bi-key"></i> Забыли пароль?
                            </a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
        
        <div class="text-center mt-3">
            <p class="text-white-50 small">
                <i class="bi bi-shield-check"></i> Безопасный вход
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}