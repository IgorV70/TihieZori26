@page
@model TihieZori.Areas.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Сброс пароля";
    Layout = "~/Areas/Identity/Pages/_AuthLayout.cshtml";
}

<style>
    .success-message {
        background: linear-gradient(135deg, #d1e7dd 0%, #a3cfbb 100%);
        border: 1px solid #a3cfbb;
        border-radius: 0.75rem;
        padding: 1rem 1.25rem;
        margin-bottom: 1.5rem;
        color: #0a3622;
        animation: slideDown 0.3s ease-out;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .error-message {
        background: linear-gradient(135deg, #f8d7da 0%, #f5c2c7 100%);
        border: 1px solid #f5c2c7;
        border-radius: 0.75rem;
        padding: 1rem 1.25rem;
        margin-bottom: 1.5rem;
        color: #842029;
        animation: slideDown 0.3s ease-out;
        box-shadow: 0 4px 12px rgba(220, 53, 69, 0.15);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <i class="bi bi-shield-lock" style="font-size: 3rem; color: #0d6efd;"></i>
                    <h3 class="mt-2">Сброс пароля</h3>
                    <p class="text-muted">Введите новый пароль</p>
                </div>

                <form method="post">
                    @Html.AntiForgeryToken()

                    @if (ViewData["SuccessMessage"] != null)
                    {
                        <div class="success-message" role="alert">
                            <span class="success-icon">✅</span>
                            <p class="success-text">@ViewData["SuccessMessage"]</p>
                        </div>
                    }

                    @if (ViewData["ErrorMessage"] != null)
                    {
                        <div class="error-message" role="alert">
                            <span class="error-icon">❌</span>
                            <p class="error-text">@ViewData["ErrorMessage"]</p>
                        </div>
                    }

                    <input asp-for="Input.Code" type="hidden" />
                    <input asp-for="Input.Email" type="hidden" />

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" placeholder="password" type="password" />
                        <label asp-for="Input.Password">Новый пароль</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.ConfirmPassword" class="form-control" placeholder="password" type="password" />
                        <label asp-for="Input.ConfirmPassword">Подтвердите пароль</label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button type="submit" class="w-100 btn btn-lg btn-primary">
                        <i class="bi bi-check-circle"></i> Сбросить пароль
                    </button>

                    <div class="mt-3 text-center">
                        <a asp-page="./Login" class="text-decoration-none">
                            <i class="bi bi-arrow-left"></i> Вернуться ко входу
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}