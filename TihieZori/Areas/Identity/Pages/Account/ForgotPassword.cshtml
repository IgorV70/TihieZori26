@page
@model TihieZori.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Восстановление пароля";
    Layout = "~/Areas/Identity/Pages/_AuthLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <i class="bi bi-key" style="font-size: 3rem; color: #ffc107;"></i>
                    <h3 class="mt-2">Забыли пароль?</h3>
                    <p class="text-muted">Мы отправим ссылку для сброса на ваш email</p>
                </div>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" placeholder="name@example.com" />
                        <label asp-for="Input.Email">Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <button type="submit" class="w-100 btn btn-lg btn-warning">
                        <i class="bi bi-envelope"></i> Отправить ссылку
                    </button>

                    <div class="mt-3 text-center">
                        <a asp-page="./Login" class="text-decoration-none">
                            <i class="bi bi-arrow-left"></i> Вернуться ко входу
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>