<UserControl x:Class="EntityManager.View.DatabaseViewT4"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="350">
	<StackPanel>
		<StackPanel Orientation="Horizontal">
			<Label Width="120" Height="28" >Первичный ключ, автонумератор</Label>
			<TextBox Width="200" Height="23" Text="{Binding Selected.Id}"/>
		</StackPanel>
		<StackPanel Orientation="Horizontal">
			<Label Width="120" Height="28" >Наименование параметра</Label>
			<TextBox Width="200" Height="23" Text="{Binding Selected.Name}"/>
		</StackPanel>
		<StackPanel Orientation="Horizontal">
			<Label Width="120" Height="28" >Комментарий</Label>
			<TextBox Width="200" Height="23" Text="{Binding Selected.Comment}"/>
		</StackPanel>
	</StackPanel>

</UserControl>
