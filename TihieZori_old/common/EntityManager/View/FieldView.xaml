<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EntityManager.View" x:Class="EntityManager.View.FieldView" 
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="420">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
            <Label Grid.Column="0" Grid.Row="0" Width="210" Height="28" Content="Наименование параметра" />
        <TextBox  Grid.Column="1" Grid.Row="0" Width="200" Height="23" Text="{Binding Selected.Name}"/>
        
            <Label  Grid.Column="0" Grid.Row="1" Width="210" Height="28" Content="Комментарий" />
            <TextBox  Grid.Column="1" Grid.Row="1" Width="200" Height="23" Text="{Binding Selected.Comment}"/>
        
            <Label Grid.Column="0" Grid.Row="2" Width="210" Height="28" Content="Тип SQL" />
            <ComboBox  Grid.Column="1" Grid.Row="2" Width="200" Height="23" Text="{Binding Selected.FType}" IsEditable="True" >
                <ComboBoxItem Tag="int" Content="int"/>
                <ComboBoxItem Tag="nvarchar" Content="nvarchar"/>
                <ComboBoxItem Tag="image" Content="image"/>
                <ComboBoxItem Tag="ntext" Content="ntext"/>
                <ComboBoxItem Tag="decimal" Content="decimal"/>
                <ComboBoxItem Tag="smalldatetime" Content="smalldatetime"/>
                <ComboBoxItem Tag="datetime" Content="datetime"/>
                <ComboBoxItem Tag="bit" Content="bit"/>
                <ComboBoxItem Tag="varbinary" Content="varbinary"/>
                <ComboBoxItem Tag="uniqueidentifier" Content="uniqueidentifier"/>
            </ComboBox>
            <Label  Grid.Column="0" Grid.Row="3" Width="210" Height="28" Content="Размер" />
            <TextBox  Grid.Column="1" Grid.Row="3" Width="200" Height="23" Text="{Binding Selected.Size}"/>
        
            <Label  Grid.Column="0" Grid.Row="4"  Width="210" Height="28" Content="Размер2" />
            <TextBox Grid.Column="1" Grid.Row="4"  Width="200" Height="23" Text="{Binding Selected.Size2}"/>
        
            <Label  Grid.Column="0" Grid.Row="5" Width="210" Height="28" Content="Тип Cs" />
            <ComboBox  Grid.Column="1" Grid.Row="5" Width="200" Height="23" Text="{Binding Selected.FTypeCS}" IsEditable="True" >
                <ComboBoxItem Tag="Byte" Content="Byte"/>
                <ComboBoxItem Tag="int" Content="int"/>
                <ComboBoxItem Tag="Int16" Content="Int16"/>
                <ComboBoxItem Tag="Int32" Content="Int32"/>
                <ComboBoxItem Tag="Int64" Content="Int64"/>
                <ComboBoxItem Tag="string" Content="string"/>
                <ComboBoxItem Tag="byte[]" Content="byte[]"/>
                <ComboBoxItem Tag="Decimal" Content="Decimal"/>
                <ComboBoxItem Tag="DateTime" Content="DateTime"/>
                <ComboBoxItem Tag="bool" Content="bool"/>
                <ComboBoxItem Tag="Image" Content="Image"/>
            </ComboBox>

            <Label  Grid.Column="0" Grid.Row="6"  Width="210" Height="28" Content="Автонумератор" />
            <CheckBox  Grid.Column="1" Grid.Row="6" Width="16" Height="16" IsChecked="{Binding Selected.IsIdentity}"/>

            <Label  Grid.Column="0" Grid.Row="7" Width="210" Height="28" Content="Входит в перв. ключ" />
            <CheckBox  Grid.Column="1" Grid.Row="7" Width="16" Height="16" IsChecked="{Binding Selected.IsPrimary}"/>

            <Label  Grid.Column="0" Grid.Row="8" Width="210" Height="28" Content="Nullable" />
            <CheckBox  Grid.Column="1" Grid.Row="8" Width="16" Height="16" IsChecked="{Binding Selected.IsNullable}"/>
            <Label  Grid.Column="0" Grid.Row="9" Width="210" Height="28" Content="Значение по умолчанию" />
            <TextBox  Grid.Column="1" Grid.Row="9" Width="200" Height="23" Text="{Binding Selected.DefaultValue}"/>
            <Label  Grid.Column="0" Grid.Row="10"  Width="210" Height="28" Content="Только чтение" />
            <CheckBox  Grid.Column="1" Grid.Row="10" Width="16" Height="16" IsChecked="{Binding Selected.IsReadOnly}"/>

            <Label  Grid.Column="0" Grid.Row="11"  Width="210" Height="28" Content="Логировать" />
            <CheckBox  Grid.Column="1" Grid.Row="11" Width="16" Height="16" IsChecked="{Binding Selected.IsChangesLog}"/>

            <Label  Grid.Column="0" Grid.Row="12" Width="210" Height="28" Content="Отложенное" />
            <CheckBox Grid.Column="1" Grid.Row="12"  Width="16" Height="16" IsChecked="{Binding Selected.IsPostPoned}"/>

            <Label Grid.Column="0" Grid.Row="13"  Width="210" Height="28" Content="Мультиязыковое" />
            <CheckBox  Grid.Column="1" Grid.Row="13" Width="16" Height="16" IsChecked="{Binding Selected.IsMultiLang}"/>

            <Label  Grid.Column="0" Grid.Row="14" Width="210" Height="28" Content="Ссылка на таблицу" />
            <ComboBox  Grid.Column="1" Grid.Row="14" Width="200" Height="23" SelectedValue="{Binding Selected.ForeignKeyTable}" IsEditable="True" 
                      ItemsSource="{Binding TableCollection, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:FieldView}}}" DisplayMemberPath="Name" SelectedValuePath="Name"/>
        <Label  Grid.Column="0" Grid.Row="15" Width="210" Height="28" >Ссылка объект</Label>
        <TextBox  Grid.Column="1" Grid.Row="15" Width="200" Height="23" Text="{Binding Selected.ForeignObjectName}"/>
        <Label  Grid.Column="0" Grid.Row="16" Width="210" Height="28" Content="Кешировать объект" />
        <CheckBox  Grid.Column="1" Grid.Row="16" Width="16" Height="16" IsChecked="{Binding Selected.IsCashForeignObj}"/>

    </Grid>

</UserControl>
