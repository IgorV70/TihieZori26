                }
                else if (state == ObjectStateType.Added || state == ObjectStateType.Deleted)
                {
                    changes = new List<ChangedValuesItem>();
                    ChangedValuesItem item = new ChangedValuesItem();
                    item.TableName = this._table.TableName();

                    if (state == ObjectStateType.Added)
                    {
                        item.RecordNew = true;
                    }
                    else if (state == ObjectStateType.Deleted)
                    {
                        item.RecordDelete = true;
                    }
                    changes.Add(item);

